<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Change this groupId to your own organization groupId -->
  <groupId>fr.ma.moulinette</groupId>

  <!-- Change this artifactId to your own organization artifactId -->
  <artifactId>track-logger-method</artifactId>
  <version>2.0.0-RELEASE</version>
  <packaging>sonar-plugin</packaging>

  <!--  Change the name of the plugin here -->
  <name>SonarQube Java :: TLM :: Track LOGGER Method</name>

  <!--  Change the description of the plugin here -->
  <description>Track logger method for java</description>
  <url>https://github.com/Laurent-hadjadj/track-logger-method.git</url>
  <inceptionYear>2026</inceptionYear>

  <!-- Licence -->
  <licenses>
    <license>
      <name>CC-BY-NC-SA 4.0</name>
      <url>https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!-- Equipe de développement -->
  <contributors>
    <contributor>
      <name>Laurent HADJADJ</name>
      <organizationUrl>https://github.com/laurent-hadjadj</organizationUrl>
    </contributor>
  </contributors>

  <!-- outil de gestion des sources-->
  <scm>
    <connection>scm:git:https://github.com/laurent-hadjadj/track-logger-method.git</connection>
    <developerConnection>scm:git:https@github.com/laurent-hadjadj/track-logger-method.git</developerConnection>
    <url>https://github.com/Laurent-hadjadj/track-logger-method</url>
    <tag>HEAD</tag>
  </scm>

  <!-- Outil de gestion des anomalies -->
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/laurent-hadjadj/track-logger-method/issues</url>
  </issueManagement>

  <!-- Gestion des versions -->
  <properties>
    <!-- ============================================================ -->
    <!-- Versions de COMPILATION/TEST : dernière LTS annuelle validée. -->
    <!-- À bumper à chaque campagne de test contre une nouvelle LTS.   -->
    <!-- Règle : (1) version SonarQube cible -> sonar.plugin.api.version,   -->
    <!--         via la matrice de compatibilité SonarSource ;              -->
    <!--         (2) inspecter lib/extensions/sonar-java-plugin-*.jar       -->
    <!--         sur le serveur cible -> sonarjava.version.                 -->
    <!-- ============================================================ -->
    <!-- Version de SonarQube -->
    <!-- https://github.com/SonarSource/sonar-plugin-api -->
    <sonarqube.version>13.8.0.4399</sonarqube.version>
    <!-- Version du plugin API -->
    <sonar.plugin.api.version>9.17.0.587</sonar.plugin.api.version>
    <!-- repos : https://mvnrepository.com/artifact/org.sonarsource.java/sonar-java-plugin/versions -->
    <!-- Version du plugin sonar-java : sonarqube-26.3.0.120487 -> sonar-java-plugin-8.24.0.42567.jar -->
    <!-- Version du plugin sonar-java : sonarqube-26.7.0.124771 -> sonar-java-plugin-8.34.0.44906.jar -->
    <sonarjava.version>8.34.0.44906</sonarjava.version>

    <!-- ============================================================ -->
    <!-- Versions PLANCHER : compatibilité minimale garantie dans le   -->
    <!-- manifeste (pluginApiMinVersion / requirePlugins). Volontairement -->
    <!-- indépendantes des versions de compilation ci-dessus : ne pas  -->
    <!-- les bumper à chaque campagne de test, seulement en cas de     -->
    <!-- rupture volontaire du support d'anciennes versions SonarQube. -->
    <!-- Plancher actuel de la 2.0.0 : SonarQube 10.7 LTS.             -->
    <!-- ============================================================ -->
    <sonar.plugin.api.minVersion>10.7.0.96327</sonar.plugin.api.minVersion>
    <sonarjava.minVersion>8.2.0.36672</sonarjava.minVersion>

    <jacoco.version>0.8.12</jacoco.version>
    <!-- Use UTF-8 for all resources -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Compilation et build Java 17 -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Définition du chemin pour les rapports jacoco -->
    <sonar.coverage.jacoco.xmlReportPaths>target/jacoco-xml/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
  </properties>

  <dependencies>
    <!-- MAIN sources dependencies -->
    <!-- Sonarqube API plugin -->
    <dependency>
      <groupId>org.sonarsource.api.plugin</groupId>
      <artifactId>sonar-plugin-api</artifactId>
      <version>${sonar.plugin.api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Gestion des logs -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.30</version>
      <scope>provided</scope>
    </dependency>

    <!-- Plugin Java pour sonar-->
    <dependency>
      <groupId>org.sonarsource.java</groupId>
      <artifactId>sonar-java-plugin</artifactId>
      <type>sonar-plugin</type>
      <version>${sonarjava.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Analyser/parseur de code  -->
    <dependency>
      <groupId>org.sonarsource.analyzer-commons</groupId>
      <artifactId>sonar-analyzer-commons</artifactId>
      <version>2.11.0.2861</version>
    </dependency>

    <!-- TEST sources dependencies -->
    <dependency>
      <groupId>org.sonarsource.java</groupId>
      <artifactId>java-checks-testkit</artifactId>
      <version>${sonarjava.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JUnit Jupiter is the API for writing tests using JUnit 5-->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.7.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-migrationsupport</artifactId>
      <version>5.7.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.23.1</version>
      <scope>test</scope>
    </dependency>

    <!-- Mockito mock objects library core API and implementation -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.12.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Construction-->
  <build>
    <plugins>
      <!-- SonarQube :: Packaging Maven Plugin -->
      <plugin>
        <groupId>org.sonarsource.sonar-packaging-maven-plugin</groupId>
        <artifactId>sonar-packaging-maven-plugin</artifactId>
        <version>1.23.0.740</version>
        <extensions>true</extensions>
        <configuration>
          <pluginKey>track-logger-method</pluginKey>
          <pluginName>Track Logger Method</pluginName>
          <PluginDescription>Track logger method :: info, warn, error, debug</PluginDescription>
          <pluginClass>fr.ma.moulinette.java.MyJavaPlugin</pluginClass>
          <sonarLintSupported>false</sonarLintSupported>
          <skipDependenciesPackaging>true</skipDependenciesPackaging>
          <pluginApiMinVersion>${sonar.plugin.api.minVersion}</pluginApiMinVersion>
          <requirePlugins>java:${sonarjava.minVersion}</requirePlugins>
          <requiredForLanguages>java</requiredForLanguages>
          <jreMinVersion>11</jreMinVersion>
        </configuration>
      </plugin>

      <plugin>
        <!-- Repackages the project classes together with their dependencies into a single uber-jar, optionally renaming classes or removing unused classes. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <!-- Évite le warning "overlapping resource: META-INF/MANIFEST.MF" : le manifeste
              embarqué dans sonar-analyzer-commons entre en collision avec celui généré par
              sonar-packaging-maven-plugin pour le jar final. Seul ce dernier doit être conservé. -->
          <filters>
            <filter>
              <artifact>org.sonarsource.analyzer-commons:sonar-analyzer-commons</artifact>
              <excludes>
                <exclude>META-INF/MANIFEST.MF</exclude>
              </excludes>
            </filter>
          </filters>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- The Compiler Plugin is used to compile the sources of your project. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.9.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
          <release>17</release>
        </configuration>
      </plugin>

      <!-- The JaCoCo Maven Plugin provides the JaCoCo runtime agent to your tests and allows basic report creation. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <destFile>target/jacoco.exec</destFile>
          <outputDirectory>target/jacoco-xml</outputDirectory>
          <outputEncoding>UTF-8</outputEncoding>
        </configuration>
      </plugin>

      <!-- only required to run UT - these are UT dependencies -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy</id>
            <phase>test-compile</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.slf4j</groupId>
                  <artifactId>slf4j-api</artifactId>
                  <version>1.7.30</version>
                  <type>jar</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.apache.commons</groupId>
                  <artifactId>commons-collections4</artifactId>
                  <version>4.0</version>
                  <type>jar</type>
                </artifactItem>
                <artifactItem>
                  <groupId>javax</groupId>
                  <artifactId>javaee-api</artifactId>
                  <version>6.0</version>
                  <type>jar</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.springframework</groupId>
                  <artifactId>spring-webmvc</artifactId>
                  <version>4.3.3.RELEASE</version>
                  <type>jar</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.springframework</groupId>
                  <artifactId>spring-web</artifactId>
                  <version>4.3.3.RELEASE</version>
                  <type>jar</type>
                </artifactItem>
                <artifactItem>
                  <groupId>org.springframework</groupId>
                  <artifactId>spring-context</artifactId>
                  <version>4.3.3.RELEASE</version>
                  <type>jar</type>
                </artifactItem>
                <artifactItem>
                  <groupId>junit</groupId>
                  <artifactId>junit</artifactId>
                  <version>4.13.2</version>
                  <type>jar</type>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/test-jars</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
